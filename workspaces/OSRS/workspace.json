{
  "friendly_name": "OSRS Runelite",
  "description": "Old School RuneScape in a browser-based environment using Runelite client. Play OSRS directly in your browser with all the features of the popular Runelite client.",
  "docker_registry": "ghcr.io",
  "image_src": "osrs.png",
  "run_config": {
    "hostname": "kasm",
    "security_opt": ["seccomp=unconfined"],
    "shm_size": "512m"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign'"
    }
  },
  "categories": [
    "Games"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/developmentcats/osrs-runelite-kasm:latest",
      "uncompressed_size_mb": 2500,
      "available_tags": [
        "latest"
      ]
    }
  ],
  "cores": 2,
  "memory": 2048,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "notes": "Provides browser-based access to Old School RuneScape using the Runelite client. Includes persistent storage support for settings and configurations."
}
