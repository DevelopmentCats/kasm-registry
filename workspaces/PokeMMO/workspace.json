{
  "friendly_name": "PokeMMO",
  "description": "PokeMMO is a free-to-play MMORPG based on the Pokemon games. This workspace allows you to play PokeMMO directly in your browser. IMPORTANT: Users must provide their own legitimate ROM sources.",
  "image_src": "pokemmo.png",
  "categories": [
    "Games"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/lanjelin/pokemmo-docker:latest",
      "uncompressed_size_mb": 2000,
      "available_tags": [
        "latest"
      ]
    }
  ],
  "docker_registry": "https://ghcr.io/",
  "docker_config": {
    "hostname": "kasm",
    "environment": {
      "PUID": "1000",
      "PGID": "1000",
      "TZ": "UTC",
      "DRINODE": "/dev/dri/renderD128",
      "ROM_CONFIG_POKEMON_BLACK_URL": "https://dir.chesher.xyz/Media/PokeMMO/pokemon_black.nds",
      "ROM_CONFIG_POKEMON_FIRERED_URL": "https://dir.chesher.xyz/Media/PokeMMO/pokemon_firered.gba",
      "ROM_CONFIG_POKEMON_EMERALD_URL": "https://dir.chesher.xyz/Media/PokeMMO/pokemon_emerald.gba",
      "ROM_CONFIG_POKEMON_PLATINUM_URL": "https://dir.chesher.xyz/Media/PokeMMO/pokemon_platinum.nds",
      "ROM_CONFIG_POKEMON_HEARTGOLD_URL": "https://dir.chesher.xyz/Media/PokeMMO/pokemon_heartgold.nds"
    },
    "volumes": {
      "/pokemmo/roms": {
        "bind": "/pokemmo/roms",
        "mode": "rw"
      },
      "/pokemmo/config": {
        "bind": "/pokemmo/config",
        "mode": "rw"
      },
      "/pokemmo/data/mods": {
        "bind": "/pokemmo/data/mods",
        "mode": "rw"
      }
    },
    "devices": [
      "/dev/dri/renderD128:/dev/dri/renderD128:rwm"
    ],
    "shm_size": "2g",
    "security_opt": [
      "seccomp=unconfined"
    ],
    "entrypoint": [
      "/bin/bash",
      "-c",
      "mkdir -p /pokemmo/roms && for url in $ROM_CONFIG_POKEMON_BLACK_URL $ROM_CONFIG_POKEMON_FIRERED_URL $ROM_CONFIG_POKEMON_EMERALD_URL $ROM_CONFIG_POKEMON_PLATINUM_URL $ROM_CONFIG_POKEMON_HEARTGOLD_URL; do filename=\"/pokemmo/roms/$(basename $url)\"; if [ ! -f \"$filename\" ]; then echo \"Downloading $(basename $url)...\"; wget -q --show-progress -O \"$filename\" \"$url\" || echo \"Failed to download $(basename $url)\"; else echo \"ROM already exists: $(basename $url)\"; fi; done && /dockerstartup/custom_startup.sh"
    ]
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "launch_config": {
    "title": "PokeMMO Configuration",
    "description": "Configure ROM paths and settings for PokeMMO",
    "fields": [
      {
        "type": "directory",
        "id": "roms_dir",
        "name": "ROMs Directory",
        "description": "Directory containing Pokemon ROM files (required)",
        "required": true,
        "target": "/pokemmo/roms"
      },
      {
        "type": "directory",
        "id": "config_dir",
        "name": "Config Directory",
        "description": "PokeMMO configuration directory",
        "required": false,
        "target": "/pokemmo/config"
      },
      {
        "type": "directory",
        "id": "mods_dir",
        "name": "Mods Directory",
        "description": "PokeMMO mods directory",
        "required": false,
        "target": "/pokemmo/data/mods"
      }
    ]
  }
} 