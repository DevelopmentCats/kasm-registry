{
  "friendly_name": "PokeMMO",
  "description": "PokeMMO is a free-to-play MMORPG based on the Pokemon games. This workspace allows you to play PokeMMO directly in your browser.",
  "docker_registry": "https://forge.dualriver.com/",
  "image_src": "pokemmo.png",
  "run_config": {
    "hostname": "kasm",
    "security_opt": ["seccomp=unconfined"],
    "shm_size": "2g",
    "environment": {
      "PUID": "1000",
      "PGID": "1000",
      "TZ": "UTC"
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Games"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "forge.dualriver.com/cat/pokemmo-docker:latest",
      "uncompressed_size_mb": 3000,
      "available_tags": [
        "latest",
        "develop"
      ]
    }
  ],
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit"
} 