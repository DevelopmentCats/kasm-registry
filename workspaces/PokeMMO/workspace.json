{
  "friendly_name": "PokeMMO",
  "description": "PokeMMO is a free-to-play MMORPG based on the Pokemon games. This workspace allows you to play PokeMMO directly in your browser.",
  "docker_registry": "ghcr.io",
  "image_src": "pokemmo.svg",
  "run_config": {
    "hostname": "kasm",
    "security_opt": ["seccomp=unconfined"],
    "shm_size": "2g",
    "environment": {
      "KASM_USER": 1000,
      "VNC_PW": "password",
      "KASM_VNC_PATH": "/usr/share/kasmvnc",
      "LANG": "en_US.UTF-8",
      "STARTUP": "/usr/local/bin/start-pokemmo",
      "DISPLAY": ":1",
      "KASM_SERVER_USER": 1000,
      "KASM_SERVER_GROUP": 1000,
      "KASM_SERVER_HOSTNAME": "kasm",
      "KASM_VNC_RESOLUTION": "1280x1024",
      "KASM_VNC_COL_DEPTH": "24",
      "KASM_STARTUP_SCRIPT": "/dockerstartup/kasm_default_profile.sh"
    },
    "devices": ["/dev/snd"],
    "volumes": {
      "/tmp/.X11-unix": "/tmp/.X11-unix"
    }
  },
  "exec_config": {
    "go": {
      "cmd": "/dockerstartup/kasm_default_profile.sh --go"
    },
    "assign": {
      "cmd": "/dockerstartup/kasm_default_profile.sh --assign"
    }
  },
  "categories": [
    "Games"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/developmentcats/pokemmo-kasm:latest",
      "uncompressed_size_mb": 3000,
      "available_tags": [
        "latest"
      ]
    }
  ],
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit"
} 